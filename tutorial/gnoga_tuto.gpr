with "settings.gpr";
with "lib_gnoga.gpr";

project Gnoga_Tuto is

   for Source_Dirs use ("tutorial-01", "tutorial-02", "tutorial-03", "tutorial-04", "tutorial-05", "tutorial-06",
                        "tutorial-07", "tutorial-08", "tutorial-09", "tutorial-10", "tutorial-11");
   for Object_Dir use Settings.Obj_Dir;
   for Exec_Dir use Settings.Exe_Dir;
   for Main use ("tutorial_01.adb", "tutorial_02.adb", "tutorial_03.adb", "tutorial_04.adb", "tutorial_05.adb",
                 "tutorial_06.adb", "tutorial_07.adb", "tutorial_08.adb", "tutorial_09.adb", "tutorial_10.adb",
                 "tutorial_11");
   for Create_Missing_Dirs use Settings'Create_Missing_Dirs;

   package Compiler is
      for Default_Switches ("Ada") use Settings.Compiler'Default_Switches ("Ada") & "-gnatyN";
   end Compiler;

   package Binder renames Settings.Binder;
   package Linker renames Settings.Linker;
   package Pretty_Printer renames Settings.Pretty_Printer;

end Gnoga_Tuto;
