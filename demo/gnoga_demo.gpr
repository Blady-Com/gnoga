with "settings.gpr";
with "lib_gnoga.gpr";
with "zanyblue.gpr";

project Gnoga_Demo is

   for Source_Dirs use ("adablog", "adaedit", "adaothello", "chattanooga", "connect_four", "leaves", "linxtris/src",
                        "localize", "logo", "mine_detector", "random_int", "snake", "tic_tac_toe");
   for Object_Dir use Settings.Obj_Dir;
   for Exec_Dir use Settings.Exe_Dir;
   for Main use ("adablog-main.adb", "adaedit.adb", "othello_game.adb", "chattanooga-program.adb",
                 "connect_four.adb", "leaves_main.adb", "linxtris.adb", "localize-main.adb",
                 "logo-main.adb", "mine_detector.adb", "random_int-program.adb", "snake-main.adb", "tic_tac_toe-program.adb");
   for Create_Missing_Dirs use Settings'Create_Missing_Dirs;

   package Builder is
      for Executable ("adablog-main.adb") use "adablog";
      for Executable ("othello_game.adb") use "othello";
      for Executable ("chattanooga-program.adb") use "chattanooga";
      for Executable ("localize-main.adb") use "localize";
      for Executable ("logo-main.adb") use "logo";
      for Executable ("random_int-program.adb") use "random_int";
      for Executable ("snake-main.adb") use "snake";
      for Executable ("tic_tac_toe-program.adb") use "tic_tac_toe";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use Settings.Compiler'Default_Switches ("Ada") & "-gnatyN";
   end Compiler;

   package Binder renames Settings.Binder;
   package Linker renames Settings.Linker;
   package Pretty_Printer renames Settings.Pretty_Printer;

end Gnoga_Demo;
